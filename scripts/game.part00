func _ready() -> void:
	name = "EggHeistWorld"
	add_child(pets_root)
	_setup_environment()
	_build_world()
	_build_farms()
	_build_shops()
	_spawn_player()
	_restore_pets()
	_build_hud()
	_update_farm_board()

func _process(delta: float) -> void:
	income_tick += delta
	if income_tick >= 1.0:
		income_tick -= 1.0
		if pet_income > 0:
			Save.data.cash = float(Save.data.cash) + pet_income
			Save.save_data()
	_update_hud()
	_update_prompt()

func _setup_environment() -> void:
	var env_node := WorldEnvironment.new()
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	var sky := Sky.new()
	var proc := ProceduralSkyMaterial.new()
	proc.sky_top_color = Color(0.12,0.38,0.72)
	proc.sky_horizon_color = Color(0.72,0.88,1.0)
	proc.ground_bottom_color = Color(0.08,0.14,0.09)
	proc.ground_horizon_color = Color(0.55,0.7,0.55)
	sky.sky_material = proc
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.72
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.fog_enabled = true
	env.fog_light_color = Color(0.64,0.76,0.84)
	env.fog_density = 0.0015
	env.fog_height = 8.0
	env.fog_height_density = 0.04
	env.glow_enabled = true
	env.glow_intensity = 0.9
	env_node.environment = env
	add_child(env_node)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-52,-28,0)
	sun.light_energy = 1.55
	sun.light_color = Color(1.0,0.93,0.82)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 280.0
	add_child(sun)
	var fill := DirectionalLight3D.new()
	fill.rotation_degrees = Vector3(-25,145,0)
	fill.light_energy = 0.28
	fill.light_color = Color(0.35,0.55,1.0)
	add_child(fill)

func _material(tex_name: String, tint := Color.WHITE, emission := Color.BLACK) -> StandardMaterial3D:
	# Web-friendly procedural material: no external texture downloads required.
	var palette := {
		"grass": Color(0.38,0.74,0.31), "grass_dark": Color(0.20,0.43,0.17),
		"water": Color(0.10,0.42,0.72), "sand": Color(0.82,0.67,0.38),
		"jungle": Color(0.14,0.48,0.20), "snow": Color(0.88,0.94,0.98),
		"lava": Color(0.28,0.07,0.035), "brick": Color(0.50,0.31,0.23),
		"stone": Color(0.35,0.38,0.42), "ice": Color(0.48,0.78,0.94)
	}
	var m := StandardMaterial3D.new()
	var base: Color = palette.get(tex_name, Color(0.55,0.58,0.58))
	m.albedo_color = base * tint
	m.roughness = 0.70
	m.metallic = 0.02
	if tex_name in ["water", "ice"]:
		m.roughness = 0.28; m.metallic = 0.08
	if tex_name == "lava":
		m.emission_enabled = true; m.emission = Color(1.0,0.18,0.02); m.emission_energy_multiplier = 1.5
	if emission != Color.BLACK:
		m.emission_enabled = true; m.emission = emission; m.emission_energy_multiplier = 2.0
	return m

func _color_mat(c: Color, emission := Color.BLACK, rough := 0.65, metal := 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new(); m.albedo_color = c; m.roughness = rough; m.metallic = metal
	if emission != Color.BLACK:
		m.emission_enabled = true; m.emission = emission; m.emission_energy_multiplier = 2.2
	return m

func _static_box(parent: Node, pos: Vector3, size_v: Vector3, mat: Material, collision := true) -> Node3D:
	var root := StaticBody3D.new() if collision else Node3D.new()
	root.position = pos; parent.add_child(root)
	var b := BoxMesh.new(); b.size = size_v
	var mi := MeshInstance3D.new(); mi.mesh = b; mi.material_override = mat; mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON; root.add_child(mi)
	if collision:
		var cs := CollisionShape3D.new(); var sh := BoxShape3D.new(); sh.size = size_v; cs.shape = sh; root.add_child(cs)
	return root

func _sphere(parent: Node, pos: Vector3, scale_v: Vector3, c: Color, emission := Color.BLACK) -> MeshInstance3D:
	var s := SphereMesh.new(); s.radial_segments = 14; s.rings = 8
	var n := MeshInstance3D.new(); n.mesh=s; n.position=pos; n.scale=scale_v; n.material_override=_color_mat(c, emission); parent.add_child(n); return n

func _cylinder(parent: Node, pos: Vector3, radius: float, height: float, c: Color, rot := Vector3.ZE