func _ready() -> void:
	name = "EggHeistWorld"
	add_child(pets_root)
	_setup_environment()
	_build_world()
	_build_farms()
	_build_shops()
	_spawn_player()
	_restore_pets()
	_build_hud()
	_update_farm_board()

func _process(delta: float) -> void:
	income_tick += delta
	if income_tick >= 1.0:
		income_tick -= 1.0
		if pet_income > 0:
			Save.data.cash = float(Save.data.cash) + pet_income
			Save.save_data()
	_update_hud()
	_update_prompt()

func _setup_environment() -> void:
	var env_node := WorldEnvironment.new()
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	var sky := Sky.new()
	var proc := ProceduralSkyMaterial.new()
	proc.sky_top_color = Color(0.12,0.38,0.72)
	proc.sky_horizon_color = Color(0.72,0.88,1.0)
	proc.ground_bottom_color = Color(0.08,0.14,0.09)
	proc.ground_horizon_color = Color(0.55,0.7,0.55)
	sky.sky_material = proc
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.72
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.fog_enabled = true
	env.fog_light_color = Color(0.64,0.76,0.84)
	env.fog_density = 0.0015
	env.fog_height = 8.0
	env.fog_height_density = 0.04
	env.glow_enabled = true
	env.glow_intensity = 0.9
	env_node.environment = env
	add_child(env_node)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-52,-28,0)
	sun.light_energy = 1.55
	sun.light_color = Color(1.0,0.93,0.82)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 280.0
	add_child(sun)
	var fill := DirectionalLight3D.new()
	fill.rotation_degrees = Vector3(-25,145,0)
	fill.light_energy = 0.28
	fill.light_color = Color(0.35,0.55,1.0)
	add_child(fill)

func _stud_material(base: Color, inset: Color, scale_v: float = 34.0) -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = "shader_type spatial; uniform vec4 base_color : source_color; uniform vec4 stud_color : source_color; uniform float tiles = 34.0; void fragment(){ vec2 q=fract(UV*tiles); vec2 d=abs(q-vec2(0.5)); float sq=1.0-smoothstep(0.30,0.38,max(d.x,d.y)); float rim=smoothstep(0.24,0.31,max(d.x,d.y))-smoothstep(0.32,0.39,max(d.x,d.y)); ALBEDO=mix(base_color.rgb,stud_color.rgb,sq*0.30+rim*0.40); ROUGHNESS=0.72; }"
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("base_color", base)
	m.set_shader_parameter("stud_color", inset)
	m.set_shader_parameter("tiles", scale_v)
	return m

func _checker_material(a: Color, b: Color, tiles_x: float = 28.0, tiles_y: float = 12.0) -> ShaderMaterial:
	var sh := Shader.new()
	sh.code = "shader_type spatial; uniform vec4 c1 : source_color; uniform vec4 c2 : source_color; uniform vec2 tiles=vec2(28.0,12.0); void fragment(){ vec2 p=floor(UV*tiles); float t=mod(p.x+p.y,2.0); ALBEDO=mix(c1.rgb,c2.rgb,t); ROUGHNESS=0.82; }"
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("c1", a); m.set_shader_parameter("c2", b); m.set_shader_parameter("tiles", Vector2(tiles_x,tiles_y))
	return m

func _material(tex_name: String, tint := Color.WHITE, emission := Color.BLACK) -> Material:
	var palette := {
		"grass": Color(0.30,0.92,0.10), "grass_dark": Color(0.16,0.47,0.12),
		"lake": Color(0.18,0.69,0.92), "abyss": Color(0.08,0.25,0.55),
		"sand": Color(0.87,0.70,0.34), "jungle": Color(0.13,0.60,0.17),
		"snow": Color(0.84,0.94,0.98), "lava": Color(0.31,0.055,0.025),
		"stone": Color(0.37,0.40,0.43), "cosmic":Color(0.17,0.055,0.36),
		"sakura":Color(0.82,0.46,0.61), "temple":Color(0.58,0.48,0.28),
		"heaven":Color(0.68,0.76,0.92), "enchanted":Color(0.15,0.61,0.31)
	}
	var base: Color = palette.get(tex_name, Color(0.55,0.58,0.58)) * tint
	if tex_name in ["grass","grass_dark","jungle","snow","sand","sakura","enchanted","temple","heaven"]:
		return _stud_material(base, base.lightened(0.14), 38.0)
	var m := StandardMaterial3D.new()
	m.albedo_color = base; m.roughness = 0.62
	if tex_name in ["lake","abyss"]:
		m.metallic = 0.12; m.roughness = 0.24
	if tex_name in ["lava","cosmic"]:
		m.emission_enabled = true; m.emission = base.lightened(0.25); m.emission_energy_multiplier = 0.65
	if emission != Color.BLACK:
		m.emission_enabled = true; m.emission = emission; m.emission_energy_multiplier = 2.0
	return m

func _color_mat(c: Color, emission := Color.BLACK, rough := 0.65, metal := 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new(); m.albedo_color = c; m.roughness = rough; m.metallic = metal
	if emission != Color.BLACK:
		m.emission_enabled = true; m.emission = emission; m.emission_energy_multiplier = 2.2
	return m

func _static_box(parent: Node, pos: Vector3, size_v: Vector3, mat: Material, collision := true) -> Node3D:
	var root := StaticBody3D.new() if collision else Node3D.new()
	root.position = pos; parent.add_child(root)
	var b := BoxMesh.new(); b.size = size_v
	var mi := MeshInstance3D.new(); mi.mesh = b; mi.material_override = mat; mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON; root.add_child(mi)
	if collision:
		var cs := CollisionShape3D.new(); var sh := BoxShape3D.new(); sh.size = size_v; cs.shape = sh; root.add_child(cs)
	return root

func _sphere(parent: Node, pos: Vector3, scale_v: Vector3, c: Color, emission := Color.BLACK) -> MeshInstance3D:
	var s := SphereMesh.new(); s.radial_segments = 14; s.rings = 8
	var n := MeshInstance3D.new(); n.mesh=s; n.position=pos; n.scale=scale_v; n.material_override=_color_mat(c, emission); parent.add_child(n); return n

func _cylinder(parent: Node, pos: Vector3, radius: float, height: float, c: Color, rot := Vector3.ZE